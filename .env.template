# ==============================================================================
# .env.template — ISOCBC NATIONAL BOOK
# ==============================================================================
# Copy to `.env` and fill in. NEVER commit `.env` — it is gitignored.
#
#   cp .env.template .env
#
# Every value below is a placeholder or a safe default. Do not put real secrets
# in this file, in a commit, in an issue, or in a chat message.
# ==============================================================================

# ------------------------------------------------------------------------------
# Project
# ------------------------------------------------------------------------------
PROJECT_NAME=ISOCBC-NATIONAL-BOOK
PROJECT_ROOT=.
# Directory the writer pipeline emits drafts into (gitignored)
OUTPUT_DIR=_output
# debug | info | warning | error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Model provider
# ------------------------------------------------------------------------------
# Which provider the writer/reviewer agents call: openai | anthropic | google | ollama
LLM_PROVIDER=anthropic
# Primary model for drafting lessons (the MKUBWA persona)
LLM_MODEL=claude-sonnet-4-5
# Cheaper model for linting, rubric generation and batch checks
LLM_MODEL_FAST=claude-haiku-4-5
# 0.0 - 1.0. Keep drafting low-ish; the style guide forbids cringe, not creativity.
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=8192

# ------------------------------------------------------------------------------
# API credentials  (leave blank if unused — blank keys are skipped, not fatal)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Only needed for self-hosted / local models
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Retrieval / grounding
# ------------------------------------------------------------------------------
# The KICD designs and approved texts (KLB etc.) that ground every lesson.
# Grounding files are large and must NOT be committed to this repo.
KICD_DESIGNS_DIR=/path/to/kicd/curriculum-designs
KLB_SOURCE_DIR=/path/to/approved/textbooks
# Retrieval backend: none | chroma | qdrant | pgvector
VECTOR_DB=none
VECTOR_DB_URL=
VECTOR_DB_COLLECTION=isocbc_kicd

# ------------------------------------------------------------------------------
# KICD compliance
# ------------------------------------------------------------------------------
# Canonical source for the year's designs, used by the sync check
KICD_BASE_URL=https://kicd.ac.ke
# Fail the build (not just warn) when a lesson misses a mapped outcome
KICD_STRICT_COMPLIANCE=true
# Default target band for generated lessons: BE | AE | ME | EE
KICD_TARGET_FLOOR=ME
KICD_TARGET_AIM=EE

# ------------------------------------------------------------------------------
# Assets
# ------------------------------------------------------------------------------
DIAGRAMS_DIR=assets/diagrams
DIAGRAMS_SOURCE_DIR=assets/diagrams/_source
# Image generation: disabled by default. Diagrams are drawn, not hallucinated.
IMAGE_GEN_ENABLED=false
IMAGE_GEN_PROVIDER=

# ------------------------------------------------------------------------------
# Review / quality gates
# ------------------------------------------------------------------------------
# Run the Style Guide §8 pre-ship checklist on every generated lesson
RUN_STYLE_LINT=true
# Run the KICD §8 per-lesson checklist on every generated lesson
RUN_COMPLIANCE_LINT=true
# Block merge if a safety callout is missing where a hazard keyword appears
REQUIRE_SAFETY_CALLOUT=true

# ------------------------------------------------------------------------------
# GitHub (only if the pipeline opens PRs / issues itself)
# ------------------------------------------------------------------------------
# A fine-grained PAT with contents:write + pull_requests:write. Never a personal password.
GITHUB_TOKEN=
GITHUB_REPO=isaacreal2026-cyber/ISOCBC-NATIONAL-BOOK

# ------------------------------------------------------------------------------
# Telemetry
# ------------------------------------------------------------------------------
# Opt-in only. Leave false unless you have a destination for the data.
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=

# ==============================================================================
# Reminder: if a real key ever lands in a commit, rotate it immediately.
# .gitignore already excludes .env, .env.* (keeping this template) and *.key/*.pem.
# ==============================================================================
